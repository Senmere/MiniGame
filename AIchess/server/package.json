{
  "name": "aichess-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "node --experimental-sqlite test-engine.mjs",
    "test:engine": "node --experimental-sqlite test-engine.mjs",
    "test:e2e": "node --experimental-sqlite test-e2e.mjs",
    "test:fallback": "node --experimental-sqlite test-fallback.mjs",
    "test:stream": "node --experimental-sqlite test-stream-chat.mjs",
    "test:breaker": "node --experimental-sqlite test-breaker.mjs",
    "test:rate-limit": "node --experimental-sqlite test-rate-limit.mjs",
    "test:mock": "node --experimental-sqlite test-mock-llm.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.0",
    "@fastify/cors": "^11.3.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
